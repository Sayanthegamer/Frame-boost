{
  "schemaVersion": 1,
  "id": "framegen",
  "version": "${version}",
  "name": "Frame Boost (2x Frame Generation)",
  "description": "Hardware-agnostic 2x Frame Generation for Minecraft Java Edition using camera matrix reprojection and depth unprojection.",
  "authors": [
    "Sayanthegamer"
  ],
  "contact": {
    "homepage": "https://github.com/Sayanthegamer/Frame-boost",
    "sources": "https://github.com/Sayanthegamer/Frame-boost",
    "issues": "https://github.com/Sayanthegamer/Frame-boost/issues"
  },
  "license": "MIT",
  "environment": "client",
  "entrypoints": {
    "client": [
      "com.framegen.FrameGenClient"
    ]
  },
  "mixins": [
    "framegen.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=0.19.5",
    "minecraft": "~26.3",
    "java": ">=25",
    "fabric-api": "*"
  }
}
